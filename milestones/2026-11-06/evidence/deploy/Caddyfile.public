{
	admin off
	persist_config off
	storage file_system "{$COPILOT_CADDY_STORAGE}"
	log {
		output file "{$COPILOT_CADDY_STORAGE}/diagnostics.jsonl" {
			roll_size 1MiB
			roll_keep 2
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
	servers {
		strict_sni_host on
		protocols h1 h2
	}
}

(https_common) {
	bind 0.0.0.0
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

https://app.scpilot.tech {
	import https_common
	header Content-Security-Policy "frame-ancestors 'none'; frame-src https://store.scpilot.tech"
	@api path /health /shopper/* /sessions /sessions/* /speech/*
	handle @api {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			stream_timeout 30m
			header_up -X-Service-Secret
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
	@assets path / /assets/*
	handle @assets {
		root * "{$COPILOT_PANEL_ROOT}"
		file_server
	}
	handle {
		respond 404
	}
}

https://store.scpilot.tech {
	import https_common
	header Content-Security-Policy "frame-ancestors https://app.scpilot.tech"
	@private path_regexp private (?i)^/(__internal|__test|__probe|step)(/|$)
	handle @private {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:4000 {
			header_up -X-Service-Secret
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
}
