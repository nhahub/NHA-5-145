# The deterministic adapter keeps ordinary local tests and manual smoke checks network-free.
LLM_PROVIDER=scripted
LLM_MODEL=scripted-v1

# Local service identity: python scripts/init_local_identity.py
# Generated value stays in ignored work/local-identity.json, never browser bundles.
# For deployment inject COPILOT_SERVICE_SECRET through the server environment.
# COPILOT_PANEL_ORIGIN=https://<panel-host>
# COPILOT_STORE_ORIGIN=https://<store-host>
# COPILOT_STORE_PRIVATE_URL=http://127.0.0.1:4000
# COPILOT_ENV=production
# Public origins above configure server validation only; cloud browser/proxy wiring
# is a separate deployment step. Never enable COPILOT_EVALUATION in public hosting.

# Pinned local MVP baseline. Keep the real key only in `.env`.
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=<local-secret>
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT_SECONDS=20
# LLM_REASONING_EFFORT=low

# Enable these NVIDIA settings only for an explicit local evaluation or smoke test.
# Keep the real key only in `.env`.
# LLM_PROVIDER=nvidia
# LLM_MODEL=<evaluated-model-id>
# NVIDIA_API_KEY=<local-secret>
# LLM_TIMEOUT_SECONDS=20
# NVIDIA_STREAM=false

# The later AWS milestone will use the standard AWS credential chain.
# AWS_REGION=eu-central-1
# Optional Gemini evaluation (keep the real key in ignored .env only).
# GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# OpenRouter paid evaluation requires a non-resetting API key limit.
# Default local maximum is $0.25; larger limits require explicit owner approval.
# The actual key limit and this local limit must agree; never enable auto top-up.
# OPENROUTER_API_KEY=
# OPENROUTER_TOTAL_CAP_DOLLARS=0.25
# LLM_PROVIDER=openrouter
# LLM_MODEL=google/gemini-3.5-flash-lite

# Bounded catalogue retrieval is opt-in until live-model qualification passes.
# Storefront always reads SQLite; import seeds explicitly before starting it.
# COPILOT_CATALOGUE_DB=<absolute-path-to-local-sqlite-file>
CATALOGUE_RETRIEVAL_ENABLED=0
CATALOGUE_RANKING=lexical
# Hybrid additionally requires the pinned local encoder cache and a fresh offline index.
# CATALOGUE_MODEL_CACHE=<absolute-path-to-prepopulated-model-cache>

# Production requires explicit invited admission; local development can opt in.
# Initialize outside disposable releases: python -m agent.admission initialize --path <path>
# See docs/cap04-invited-access.md; do not put actual access codes in this file.
# ADMISSION_DB_PATH=<absolute-path-to-private-admission-sqlite>
# ADMISSION_DB_ID=<saved-ledger-identity>
# ADMISSION_MAX_REQUEST_BYTES=2621440
# ADMISSION_REQUESTS_PER_MINUTE=1000
# ADMISSION_BROWSER_REQUESTS_PER_MINUTE=120
# ADMISSION_MAX_ACTIVE_REQUESTS=16
# ADMISSION_MAX_STREAMS=16
# ADMISSION_MAX_SESSIONS=20
# ADMISSION_MAX_BROWSER_SESSIONS=2
